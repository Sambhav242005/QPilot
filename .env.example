# QPilot Environment Variables

# ─── LLM Configuration (OpenAI-compatible) ────────────────────────────
# Supports Ollama, OpenAI, Together, Groq, etc.

# API base URL
LLM_URL=http://localhost:11434/v1

# API key (required by OpenAI client, use "ollama" for local Ollama)
LLM_API_KEY=ollama

# Model name
LLM_MODEL_NAME=gemma4:31b-cloud

# ─── Database ─────────────────────────────────────────────────────────

# SQLite Database URL (default local development - no server needed)
DATABASE_URL=sqlite+aiosqlite:///./qpilot.db

# PostgreSQL Database URL (Docker/production)
# DATABASE_URL=postgresql+asyncpg://qpilot:qpilot@localhost:5432/qpilot

# ─── Application ──────────────────────────────────────────────────────

# Backend Host
BACKEND_HOST=0.0.0.0

# Backend Port
BACKEND_PORT=8000

# File Upload Max Size in bytes (10MB)
MAX_UPLOAD_SIZE=10485760

# ─── Streaming ────────────────────────────────────────────────────────

# Enable streaming responses
ENABLE_STREAMING=true

# ─── Frontend ─────────────────────────────────────────────────────────

# API URL for frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
