# QPilot Environment Variables

# ─── LLM Configuration (OpenAI-compatible) ────────────────────────────
# Supports Ollama, OpenAI, Together, Groq, etc.

# API base URL
LLM_URL=http://localhost:11434/v1

# API key (required by OpenAI client, use "ollama" for local Ollama)
LLM_API_KEY=ollama

# Model name
LLM_MODEL_NAME=gemma4:31b-cloud

# To use Groq instead, create an API key at https://console.groq.com/keys and
# replace the three LLM values above with the following (keep the key private):
# LLM_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_your_groq_api_key
# LLM_MODEL_NAME=openai/gpt-oss-20b

# ─── Database ─────────────────────────────────────────────────────────

# SQLite Database URL (default local development - no server needed)
DATABASE_URL=sqlite+aiosqlite:///./qpilot.db

# PostgreSQL Database URL (Docker/production)
# DATABASE_URL=postgresql+asyncpg://qpilot:qpilot@localhost:5432/qpilot

# ─── Application ──────────────────────────────────────────────────────

# Backend Host
BACKEND_HOST=0.0.0.0

# Backend Port
BACKEND_PORT=8000

# Allowed browser origins (JSON array). Set this to the Railway frontend domain
# in production, for example: ["https://your-frontend.up.railway.app"]
CORS_ORIGINS=["http://localhost:3000"]

# File Upload Max Size in bytes (10MB)
MAX_UPLOAD_SIZE=10485760

# ─── Streaming ────────────────────────────────────────────────────────

# Enable streaming responses
ENABLE_STREAMING=true

# ─── Frontend ─────────────────────────────────────────────────────────

# API URL for frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
